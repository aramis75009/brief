#==============================================================================
# .env.production — VPS. Copier en .env.production et remplir.
# Ne jamais committer le fichier rempli.
#==============================================================================
NEXT_PUBLIC_APP_NAME=Brief

# Domaine public, servi en TLS par Caddy (deploy/Caddyfile).
# Doit DÉJÀ pointer vers l'IP du VPS par un enregistrement A avant le premier
# `up` : Let's Encrypt vérifie depuis l'extérieur.
BRIEF_DOMAIN=
BRIEF_TLS_EMAIL=aramis.begnene@gmail.com

# Accès de l'app
BRIEF_PIN=

# Jetons machine — DISTINCTS du PIN, révocables séparément.
# Un par usage : révoquer celui de n8n ne doit pas éteindre les rappels.
# openssl rand -base64 32
BRIEF_CRON_TOKEN=
BRIEF_CAPTURE_TOKEN=
# Lecture seule du récap du matin (GET /api/digest), pour n8n.
BRIEF_DIGEST_TOKEN=
# Synchro Brief → calendrier Apple (CalDAV iCloud) — la route cron caldav-sync.
BRIEF_CALDAV_TOKEN=

# --- CalDAV Apple (iCloud) ----------------------------------------------------
# Compte iCloud + mot de passe d'application (appleid.apple.com → Mots de passe
# d'application — jamais le mot de passe du compte Apple).
BRIEF_CALDAV_USER=
BRIEF_CALDAV_PASSWORD=
# Chemin du calendrier cible. Vide = calendrier par défaut d'iCloud
# (Personnel). Exemple : /16391108573/calendars/home/
BRIEF_CALDAV_CALENDAR_PATH=

# Groq
GROQ_API_KEY=
TRANSCRIBE_PROVIDER=groq
TRANSCRIBE_MODEL=whisper-large-v3
PARSE_MODEL=openai/gpt-oss-20b

# Supabase (auth email + mot de passe) — build-time, comme la clé VAPID :
# absentes au build, undefined dans le bundle navigateur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloisonnement par compte (pivot du 2026-08-31) — lues à l'EXÉCUTION.
# Clé service-role Supabase : la seule qui contourne RLS, et la plus puissante
# du projet. Les crons n'ont pas de session et s'en servent pour lister les
# comptes (`src/lib/supabase/admin.ts`). Jamais exposée au navigateur.
SUPABASE_SECRET_KEY=
# UUID Supabase du compte propriétaire, à lire dans `authorized_users`.
# Quatre rôles : la migration au démarrage lui attribue les données d'avant le
# multi-utilisateur ; les jetons `capture` / `digest` écrivent chez lui ; la
# synchro CalDAV ne traite QUE ce compte ; les rappels s'y replient si Supabase
# est injoignable. Absente, la synchro calendrier s'arrête (503).
BRIEF_OWNER_USER_ID=

# Web Push — npx web-push generate-vapid-keys --json
# La clé PUBLIQUE doit aussi être passée au build (voir docker-compose.yml).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:aramis.begnene@gmail.com

# Données. Aligné sur le volume du conteneur.
BRIEF_DATA_DIR=/app/data
