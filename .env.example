#==============================================================================
# .env.example — Brief
# Template committé : mêmes clés que .env.local, valeurs vides.
# Copier vers .env.local et remplir :  cp .env.example .env.local
#==============================================================================

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Brief

# --- Groq : transcription + parsing ------------------------------------------
GROQ_API_KEY=
TRANSCRIBE_PROVIDER=groq
TRANSCRIBE_MODEL=whisper-large-v3
PARSE_MODEL=openai/gpt-oss-20b

# --- Accès -------------------------------------------------------------------
BRIEF_PIN=

# --- Jetons machine (cron et raccourci iOS) ----------------------------------
# Volontairement DISTINCTS de BRIEF_PIN : un secret stocké dans une crontab ou
# dans un raccourci iOS ne doit pas ouvrir la même porte que le code de l'app.
# Générer :  openssl rand -base64 32
BRIEF_CRON_TOKEN=
BRIEF_CAPTURE_TOKEN=

# --- Web Push : notifications de rappel --------------------------------------
# Générer une paire :  npx web-push generate-vapid-keys --json
# La clé publique est exposée au navigateur, la privée ne doit jamais l'être.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:aramis.begnene@gmail.com

# Dossier de données serveur (abonnements push). Éphémère sur Vercel.
# BRIEF_DATA_DIR=

# --- Optionnel : bascule vers Voicebox en local ------------------------------
# VOICEBOX_URL=
