#==============================================================================
# .env.example — Brief
# Template committé : mêmes clés que .env.local, valeurs vides.
# Copier vers .env.local et remplir :  cp .env.example .env.local
#==============================================================================

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Brief

# --- Groq : transcription + parsing ------------------------------------------
GROQ_API_KEY=
TRANSCRIBE_PROVIDER=groq
TRANSCRIBE_MODEL=whisper-large-v3
PARSE_MODEL=openai/gpt-oss-20b

# --- LLM de secours (parsing naturel des dates, chat) ------------------------
# Ollama Cloud. Si absent, le parsing retombe sur Groq.
OLLAMA_API_KEY=
# Modèle du chat (bottom-sheet « Demander à l'IA ») et du parse.
# CHAT_MODEL=

# --- Accès -------------------------------------------------------------------
# L'accès humain passe par Supabase Auth (email + mot de passe) — section plus
# bas. L'ancien BRIEF_PIN est supprimé depuis le 26/08 : ne pas le remettre.

# --- Jetons machine (cron, raccourci iOS, automates) -------------------------
# Volontairement DISTINCTS de la session utilisateur : un secret stocké dans
# une crontab, un raccourci iOS ou un automate ne doit pas ouvrir la même porte
# que la session. Un jeton par usage, pour que révoquer l'un n'éteigne pas les
# autres.
# Générer :  openssl rand -base64 32
BRIEF_CRON_TOKEN=
BRIEF_CAPTURE_TOKEN=
# Lecture seule du récap du matin (GET /api/digest), pour n8n.
BRIEF_DIGEST_TOKEN=
# Synchro Brief → calendrier Apple (CalDAV iCloud) — la route cron caldav-sync.
BRIEF_CALDAV_TOKEN=

# --- CalDAV Apple (iCloud) ----------------------------------------------------
# Compte iCloud + mot de passe d'application (appleid.apple.com → Mots de passe
# d'application — jamais le mot de passe du compte Apple).
BRIEF_CALDAV_USER=
BRIEF_CALDAV_PASSWORD=
# Racine CalDAV. Vide = https://caldav.icloud.com/ (défaut iCloud).
# BRIEF_CALDAV_ROOT=
# Chemin du calendrier cible. Vide = calendrier par défaut d'iCloud
# (Personnel). Exemple : /16391108573/calendars/home/
BRIEF_CALDAV_CALENDAR_PATH=
# Surcharge JSON de la correspondance type d'item → calendrier.
# BRIEF_CALDAV_MAPPING=

# --- Supabase (auth email + mot de passe) — build-time, comme la clé VAPID :
# absentes au build, undefined dans le bundle navigateur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Cloisonnement par compte (pivot du 2026-08-31) — lues à l'EXÉCUTION ------
# Clé service-role Supabase : la seule qui contourne RLS, et la plus puissante
# du projet. Les crons n'ont pas de session et s'en servent pour lister les
# comptes (`src/lib/supabase/admin.ts`). Jamais exposée au navigateur.
SUPABASE_SECRET_KEY=
# UUID Supabase du compte propriétaire, à lire dans `authorized_users`.
# Quatre rôles : la migration au démarrage lui attribue les données d'avant le
# multi-utilisateur ; les jetons `capture` / `digest` écrivent chez lui ; la
# synchro CalDAV ne traite QUE ce compte ; les rappels s'y replient si Supabase
# est injoignable. Absente, la synchro calendrier s'arrête (503).
BRIEF_OWNER_USER_ID=

# --- Web Push : notifications de rappel --------------------------------------
# Générer une paire :  npx web-push generate-vapid-keys --json
# La clé publique est exposée au navigateur, la privée ne doit jamais l'être.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:aramis.begnene@gmail.com

# --- URL publique de l'app (liens dans les notifications, auth) --------------
# NEXT_PUBLIC_APP_URL=

# Dossier de données serveur (items, abonnements push). Défaut ./data en
# local ; /app/data dans le conteneur (volume brief-data).
# BRIEF_DATA_DIR=

# --- Optionnel : bascule vers Voicebox en local ------------------------------
# VOICEBOX_URL=
